# Test Environment Variables
NODE_ENV=test
PORT=5001
MONGODB_URI=mongodb://localhost:27017/ecommerce_test

# JWT secrets (AuthService requires both)
JWT_ACCESS_SECRET=test_access_secret_at_least_32_chars_long_for_testing
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_chars_long_for_testing
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (skipped by emailService when placeholder values detected)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword

# Stripe test keys (StripeService checks for sk_ prefix)
STRIPE_SECRET_KEY=sk_test_testing_key
STRIPE_PUBLIC_KEY=pk_test_testing_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# PayPal (test values)
PAYPAL_CLIENT_ID=test_paypal_client_id
PAYPAL_CLIENT_SECRET=test_paypal_client_secret

# Cloudinary (mock for testing)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Frontend URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Typesense (semantic search)
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=typesense_dev_api_key

# Qdrant (vector store for AI recommendations)
QDRANT_URL=http://localhost:6333

# OpenAI (embeddings for AI recommendations)
OPENAI_API_KEY=sk-your-openai-api-key

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Connect (marketplace seller payouts)
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# Marketplace platform fee (percent taken from each order)
PLATFORM_FEE_PERCENT=5

# Razorpay (for UPI payments — India)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# GST invoice config (India)
SELLER_STATE=Maharashtra
SELLER_GSTIN=27ABCDE1234F1Z5

# Email (OPTIONAL — leave placeholder values to disable sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_NAME=E-Shop
FROM_EMAIL=your-email@gmail.com

# Client URL (frontend origin for CORS)
CLIENT_URL=http://localhost:5173

# CORS_ORIGINS — comma-separated extra allowed origins
# CORS_ORIGINS=https://yourapp.netlify.app,https://yourapp.vercel.app
